+"""One collection and retrieval-freshness policy for scheduler, health and analysis."""
+from app.config import get_settings
+DEFAULT_INTERVALS={'twitter':1,'douyin':1,'tiktok':6,'instagram':6,'youtube':24}
+
+def interval_hours(platform,settings=None):
+    settings=settings or get_settings()
+    name=getattr(platform,'value',platform)
+    overrides=getattr(settings,'source_intervals_hours',{})
+    return overrides.get(name) or getattr(settings,'scrape_interval_hours',None) or DEFAULT_INTERVALS[name]
+
+def max_age_seconds(platform,settings=None):
+    return interval_hours(platform or 'twitter',settings)*7200

@@ -0,0 +1,23 @@
+"""Collect real scraper results concurrently with explicit per-platform coverage."""
+import asyncio
+from app.regions import validate_region
+
+async def collect_trends(platforms, region, fetch):
+    async def one(platform):
+        try:
+            validate_region(platform, region)
+            result = await fetch(platform, region)
+            if not result.success:
+                return [], {"status": "failed", "error": result.error_message}
+            return [(platform.value, item) for item in result.items], {
+                "status": "ok", "count": len(result.items),
+                "source_regions": sorted({item.region for item in result.items}),
+            }
+        except ValueError as error:
+            return [], {"status": "unsupported", "error": str(error)}
+        except Exception as error:
+            return [], {"status": "failed", "error": str(error)}
+    results = await asyncio.gather(*(one(platform) for platform in platforms))
+    items = [item for rows, _ in results for item in rows]
+    coverage = {platform.value: status for platform, (_, status) in zip(platforms, results)}
+    return items, coverage

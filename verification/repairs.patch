+    def _parse_chart_data(self, data: dict) -> list[TrendItem]:
+        expected_region = get_region(self.region)["youtube"].lower()
+        source = f"https://charts.youtube.com/charts/TopVideos/{expected_region}/weekly"
+        sections = data.get("contents", {}).get("sectionListRenderer", {}).get("contents", [])
+        for section in sections:
+            content = section.get("musicAnalyticsSectionRenderer", {}).get("content", {})

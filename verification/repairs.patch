+    q=checked_query(q);region=checked_region(region)
+    expansion=await expand_keywords(q)
+    items,coverage=await collect_trends(list(Platform),region,fetch)
+    scored=find_related_from_trends(q,items,expanded_keywords=expansion['expanded'],min_score=min_relevance)

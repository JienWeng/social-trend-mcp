@@ -0,0 +1,47 @@
+"""Shared PostgreSQL-backed captures and evidence-based analysis."""
+from fastapi import APIRouter,Depends,Query,HTTPException
+from datetime import datetime,timedelta
+from app.timeutils import utcnow
+from app.services.trend_analysis import timestamp
+from app.services.change_report import get_changes
+from fastapi.responses import JSONResponse
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+from app.database import get_db
+from app.models import ScrapeSnapshot,TrendTopic
+from app.services import trend_service
+from app.content import load_topics
+from app.services.trend_analysis import analyze_database
+from app.routers.trends import checked_platform,checked_region
+
+router=APIRouter(prefix='/api/v1/analysis',tags=['analysis'])
+
+
+@router.get('/trends')
+async def analyze_trends(platform:str|None=Query(None),region:str=Query('global'),hours:int=Query(48,ge=1,le=720),limit:int=Query(20,ge=1,le=100),db:AsyncSession=Depends(get_db)):
+    target=checked_platform(platform) if platform else None
+    region=checked_region(region,target)
+    return await analyze_database(db,platform=target,region=region,hours=hours,limit=limit)
+
+
+@router.post('/capture/{platform}')
+async def capture_trends(platform:str,region:str=Query('global'),db:AsyncSession=Depends(get_db)):
+    target=checked_platform(platform);region=checked_region(region,target)
+    result=await trend_service.scrape_single_platform(target,region=region)
+    if result.get('skipped'):
+        return JSONResponse(status_code=202,content={**result,'persisted':False,'state':'capture_already_running'})
+    if not result['success']:
+        return JSONResponse(status_code=502,content={**result,'persisted':True,'state':'failure_recorded'})
+    snapshot=await db.get(ScrapeSnapshot,result['snapshot_id'])
+    topics=(await load_topics(db,[snapshot]))[snapshot.id]
+    return {'persisted':True,'state':'captured','snapshot':snapshot.to_dict(),'topics':topics}
+
+
+@router.get('/changes')
+async def changes(since:datetime=Query(...),platform:str|None=Query(None),region:str=Query('global'),limit:int=Query(20,ge=1,le=100),db:AsyncSession=Depends(get_db)):
+    target=checked_platform(platform) if platform else None
+    region=checked_region(region,target)
+    checkpoint=timestamp(since);now=utcnow()
+    if checkpoint>now or checkpoint<now-timedelta(days=30):
+        raise HTTPException(400,'since must be within the past 30 days')
+    return await get_changes(db,checkpoint,platform=target,region=region,limit=limit)
diff --git a/app/scrapers/douyin_scraper.py b/app/scrapers/douyin_scraper.py
new file mode 100644
index 0000000..4dd6393
--- /dev/null
+++ b/app/scrapers/douyin_scraper.py
@@ -0,0 +1,90 @@
+"""Logged-out official Douyin hot lists for mainland China.
+
+These undocumented public endpoints need no API key. ``hot_value`` is a
+platform heat score, not a view count. Global requests select the China board.
+"""
+import logging
+import math
+from datetime import datetime
+from urllib.parse import quote
+from zoneinfo import ZoneInfo
+
+from app.models import Platform
+from app.scrapers.base import BaseScraper, TrendItem
+
+logger = logging.getLogger(__name__)
+
+
+class DouyinScraper(BaseScraper):
+    platform = Platform.DOUYIN
+    # Each scrape tries two sources once; do not multiply failures with base retries.
+    max_retries = 1
+    timeout = 10
+    BILLBOARD_URL = 'https://www.iesdouyin.com/web/api/v2/hotsearch/billboard/word/'
+    HOT_SEARCH_URL = 'https://www.iesdouyin.com/aweme/v1/hot/search/list/'
+
+    def __init__(self, proxy: str = '', max_topics: int = 30, region: str = 'global'):
+        if region not in {'global', 'cn'}:
+            raise ValueError('Douyin supports only global and cn (mainland China)')
+        super().__init__(proxy=proxy, max_topics=max_topics, region=region)
+
+    async def scrape(self) -> list[TrendItem]:
+        errors = []
+        for source in (self.BILLBOARD_URL, self.HOT_SEARCH_URL):
+            try:
+                async with self._get_client() as client:
+                    response = await client.get(source, timeout=self.timeout)
+                    response.raise_for_status()
+                    payload = response.json()
+                if not isinstance(payload, dict) or payload.get('status_code') != 0:
+                    raise ValueError('Invalid Douyin response or nonzero status_code')
+                data = payload if source == self.BILLBOARD_URL else payload.get('data')
+                items = self._parse_list(data, source)
+                if items:
+                    return items
+                raise ValueError('No valid hot topics in source')
+            except Exception as error:
+                errors.append(f'{source}: {error}')
+                logger.warning('[douyin] %s failed: %s', source, error)
+        raise RuntimeError('All Douyin public sources failed: ' + '; '.join(errors))
+
+    def _parse_list(self, data: dict, source: str) -> list[TrendItem]:
+        if not isinstance(data, dict) or not isinstance(data.get('word_list'), list):
+            raise ValueError('Missing Douyin word_list')
+        # Source active_time is a China wall-clock time, separate from retrieval time.
+        source_time = datetime.strptime(data.get('active_time', ''), '%Y-%m-%d %H:%M:%S')
+        source_timestamp = source_time.replace(tzinfo=ZoneInfo('Asia/Shanghai')).isoformat()
+        items, seen = [], set()
+        for row in data['word_list']:
+            if not isinstance(row, dict) or not isinstance(row.get('word'), str):
+                continue
+            title = row['word'].strip()
+            score = row.get('hot_value')
+            if not title or title in seen or isinstance(score, bool):
+                continue
+            try:
+                score = float(score)
+            except (TypeError, ValueError, OverflowError):
+                continue
+            if not math.isfinite(score) or score < 0:
+                continue
+            seen.add(title)
+            items.append(TrendItem(
+                rank=len(items) + 1,
+                title=title,
+                url=f'https://www.douyin.com/search/{quote(title, safe="")}',
+                volume=score,
+                volume_label=f'{score:g} heat score' if score < 1e6 else f'{score:.0f} heat score',
+                region='cn',
+                description='Official Douyin mainland China hot list; heat score is not views.',
+                extra_data={
+                    'source': source,
+                    'source_timestamp': source_timestamp,
+                    'data_kind': 'official_public_hot_list',
+                    'metric': 'heat_score',
+                    'requested_region': self.region,
+                },
+            ))
+            if len(items) >= self.max_topics:
+                break
+        return items
diff --git a/app/services/change_report.py b/app/services/change_report.py
new file mode 100644
index 0000000..daf7557
--- /dev/null
+++ b/app/services/change_report.py
@@ -0,0 +1,91 @@
+"""Changes in observed samples since a caller-supplied checkpoint, never forecasts."""
+from datetime import timedelta
+from sqlalchemy import select,desc,func
+from app.models import Platform,ScrapeSnapshot,ScrapeStatus
+from app.content import load_topics
+from app.regions import validate_region
+from app.policy import max_age_seconds
+from app.timeutils import utcnow,iso_utc
+from app.services.trend_analysis import identity,timestamp,metric_context,measurement,source_context,analyze_database
+
+UNRANKED={'public_reels_recommendation_sample','sampled_trending_reels','third_party_hashtag_suggestions','public_hashtag_listing'}
+
+def compare_snapshots(platform,baseline,current,limit=20,now=None):
+    report={'status':'ok','baseline':baseline['snapshot'] if baseline else None,
+            'current':current['snapshot'] if current else None,'added':[],'removed':[],'changed':[],
+            'counts':{'added':0,'removed':0,'changed':0,'unchanged':0},
+            'scope':'Changes in observed samples only. Missing from a sample does not mean platform-wide disappearance.'}
+    if not current:report['status']='missing';return report
+    latest=current['snapshot']
+    if latest['status']!='success':report['status']='unavailable';return report
+    age=(timestamp(now or utcnow())-timestamp(latest.get('fetched_at') or latest.get('finished_at') or latest['started_at'])).total_seconds()
+    if age>max_age_seconds(platform):report['status']='stale'
+    if not baseline:report['status']='no_baseline';return report
+    before={identity(platform,item):item for item in baseline['topics']}
+    after={identity(platform,item):item for item in current['topics']}
+    evidence={'baseline_snapshot_id':baseline['snapshot']['id'],'current_snapshot_id':latest['id']}
+    def entry(key,item):return {'topic_key':key,'title':item['title'],'url':item.get('url',''),'evidence':evidence.copy()}
+    for key,item in after.items():
+        if key not in before:
+            report['added'].append({**entry(key,item),'meaning':'new_to_sample_since_checkpoint'});continue
+        old=before[key];warnings=[];rank_change=None;delta=percent=None
+        same_source=source_context(old)==source_context(item)
+        kind=(item.get('extra_data') or {}).get('data_kind','unknown')
+        if not same_source:warnings.append('source_context_changed')
+        ranked=kind not in UNRANKED and same_source
+        if not ranked:warnings.append('order_not_comparable_ranking')
+        if ranked and all(isinstance(x,int) and x>0 for x in [old.get('rank'),item.get('rank')]):
+            rank_change=old['rank']-item['rank']
+        context=metric_context(item);a,b=measurement(old),measurement(item)
+        comparable=same_source and context==metric_context(old) and a is not None and b is not None
+        if context!=metric_context(old):warnings.append('metric_context_changed')
+        if comparable:
+            delta=b-a
+            if delta<0 and context[0] not in {'heat score','weekly views'} and not context[1][2]:
+                warnings.append('metric_decreased_or_reset');delta=None
+            else:percent=round(delta/a*100,2) if a else None
+        changed=(rank_change not in {None,0} or (a!=b and (a is not None or b is not None)) or not same_source or context!=metric_context(old))
+        if changed:
+            report['changed'].append({**entry(key,item),'rank_before':old.get('rank') if ranked else None,
+                'rank_now':item.get('rank') if ranked else None,'rank_change':rank_change,
+                'metric':{'unit':context[0],'change':delta,'change_percent':percent},
+                'warnings':warnings,'meaning':'two_point_change_only_not_sustained_momentum'})
+        else:report['counts']['unchanged']+=1
+    report['removed']=[{**entry(key,item),'meaning':'missing_from_latest_sample'} for key,item in before.items() if key not in after]
+    report['changed'].sort(key=lambda item:abs(item['rank_change'] or 0),reverse=True)
+    for section in ['added','removed','changed']:
+        report['counts'][section]=len(report[section]);report[section]=report[section][:limit]
+    report['sections_truncated']=any(report['counts'][k]>len(report[k]) for k in ['added','removed','changed'])
+    if latest['id']==baseline['snapshot']['id']:report['status']='no_new_capture'
+    return report
+
+async def get_changes(session,since,platform=None,region='global',limit=20):
+    since=timestamp(since);now=utcnow()
+    targets=[platform] if platform else list(Platform)
+    result={'since':iso_utc(since),'generated_at':iso_utc(now),'region':region,'platforms':{},
+            'note':'Two-point changes are separate from sustained momentum. Capture times and source editions affect evidence.'}
+    pairs={};snapshots=[]
+    for target in targets:
+        try:validate_region(target,region)
+        except ValueError as error:
+            result['platforms'][target.value]={'status':'unsupported','error':str(error)};continue
+        query=select(ScrapeSnapshot).where(ScrapeSnapshot.platform==target,ScrapeSnapshot.region==region)
+        order=(desc(ScrapeSnapshot.started_at),desc(ScrapeSnapshot.id))
+        current=(await session.execute(query.order_by(*order).limit(1))).scalar_one_or_none()
+        observed_at=func.coalesce(ScrapeSnapshot.fetched_at,ScrapeSnapshot.finished_at,ScrapeSnapshot.started_at)
+        available_at=func.coalesce(ScrapeSnapshot.finished_at,ScrapeSnapshot.started_at)
+        baseline=(await session.execute(query.where(observed_at<=since,available_at<=since,
+            ScrapeSnapshot.status==ScrapeStatus.SUCCESS).order_by(desc(observed_at),desc(available_at),desc(ScrapeSnapshot.id)).limit(1))).scalar_one_or_none()
+        pairs[target]=(baseline,current)
+        snapshots.extend(row for row in [baseline,current] if row is not None)
+    contents=await load_topics(session,snapshots)
+    momentum=await analyze_database(session,platform=platform,region=region,hours=min(720,max(48,int((now-since).total_seconds()/3600)+1)),limit=limit)
+    for target,(baseline,current) in pairs.items():
+        def packed(row):return {'snapshot':row.to_dict(),'topics':contents[row.id]} if row else None
+        report=compare_snapshots(target.value,packed(baseline),packed(current),limit=limit,now=now)
+        state=momentum['platforms'].get(target.value,{})
+        report['momentum']={'status':state.get('status'),'rising_candidates':state.get('rising_candidates',0),
+            'history_truncated':state.get('history_truncated',False),
+            'topics':[t for t in state.get('topics',[]) if t['signal']=='rising_candidate']}
+        result['platforms'][target.value]=report
+    return result

+    age = max(0, int((utcnow() - timestamp).total_seconds()))
+    state = "unavailable" if snapshot.status != ScrapeStatus.SUCCESS else "stale" if age > maximum else "fresh"
+    return {"state": state, "age_seconds": age, "max_age_seconds": maximum}

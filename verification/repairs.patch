+async def initialize_database(target_engine=engine):
+    """Idempotent upgrade for existing installs as well as clean databases."""
+    from sqlalchemy import text
+    from app.models import Base
+    if target_engine.dialect.name == "postgresql":
+        # New enum values must be committed before inserts can use them.
+        async with target_engine.begin() as connection:
+            await connection.execute(text("""DO $$ BEGIN
+                IF EXISTS (SELECT 1 FROM pg_type WHERE typname='platform') THEN
+                    ALTER TYPE platform ADD VALUE IF NOT EXISTS 'DOUYIN';
+                END IF;
+            END $$"""))
+    async with target_engine.begin() as connection:
+        await connection.run_sync(Base.metadata.create_all)
+        if target_engine.dialect.name == "postgresql":
+            await connection.execute(text("ALTER TABLE scrape_snapshots ADD COLUMN IF NOT EXISTS region VARCHAR(50) NOT NULL DEFAULT 'global'"))
+            await connection.execute(text("ALTER TABLE scrape_snapshots ADD COLUMN IF NOT EXISTS content_hash VARCHAR(64)"))
+            await connection.execute(text("ALTER TABLE scrape_snapshots ADD COLUMN IF NOT EXISTS content_snapshot_id INTEGER REFERENCES scrape_snapshots(id) ON DELETE RESTRICT"))
+            await connection.execute(text("ALTER TABLE scrape_snapshots ADD COLUMN IF NOT EXISTS fetched_at TIMESTAMP"))
+            await connection.execute(text("CREATE INDEX IF NOT EXISTS ix_snapshot_content_lookup ON scrape_snapshots (platform, region, content_hash)"))
+            await connection.execute(text("CREATE INDEX IF NOT EXISTS ix_snapshot_platform_region_time ON scrape_snapshots (platform, region, started_at DESC)"))
+            await connection.execute(text("""INSERT INTO platform_configs (platform, enabled, max_topics, region, updated_at)
+                SELECT 'DOUYIN', 1, 30, 'global', now()
+                WHERE EXISTS (SELECT 1 FROM platform_configs)
+                AND NOT EXISTS (SELECT 1 FROM platform_configs WHERE platform='DOUYIN')"""))

+"""Evidence-based movement signals over stored observations; never predictions."""
+from collections import defaultdict
+from datetime import datetime,timezone,timedelta
+import math,re,unicodedata
+from urllib.parse import urlparse,parse_qs
+from sqlalchemy import select,desc
+from app.models import Platform,ScrapeSnapshot,TrendTopic
+from app.timeutils import utcnow,iso_utc
+from app.regions import validate_region
+from app.policy import max_age_seconds
+from app.content import load_topics
+
+
+def timestamp(value):
+    if isinstance(value,str):value=datetime.fromisoformat(value.replace('Z','+00:00'))
+    if value.tzinfo:value=value.astimezone(timezone.utc).replace(tzinfo=None)
+    return value
+
+
+def identity(platform,item):
+    metadata=item.get('extra_data') or {}
+    if metadata.get('hashtag_id'):return 'hashtag:'+str(metadata['hashtag_id'])
+    url=item.get('url','');parsed=urlparse(url)
+    if platform in {'youtube','instagram'} and parsed.netloc:
+        return parsed.netloc.lower().removeprefix('www.')+parsed.path.rstrip('/')+(':'+parse_qs(parsed.query).get('v',[''])[0] if platform=='youtube' else '')
+    return unicodedata.normalize('NFKC',item.get('title','')).casefold().strip().lstrip('#')
+
+
+def metric_context(item):
+    metadata=item.get('extra_data') or {}
+    kind=metadata.get('data_kind','unknown')
+    label=item.get('volume_label','').casefold()
+    unit=next((unit for unit in ['heat score','weekly views','views','likes','posts'] if unit in label),None)
+    if metadata.get('volume') is None and 'volume' in metadata and not label:unit=None
+    if kind=='youtube_weekly_music_video_chart':unit='weekly views'
+    if metadata.get('views_available') is False:unit=None
+    period=(metadata.get('chart_start_date'),metadata.get('chart_end_date'),metadata.get('period_days'))
+    return (unit,period)
+
+
+def measurement(item):
+    if metric_context(item)[0] is None:return None
+    try:
+        value=float(item.get('volume'))
+        return value if math.isfinite(value) and value>=0 else None
+    except (ValueError,TypeError):return None
+
+
+def source_context(item):
+    meta=item.get('extra_data') or {}
+    return meta.get('data_kind','unknown'),meta.get('source','unknown'),item.get('region','global')
+
+
+def independent(observations):
+    """At most one point per 15 minutes and per explicit source edition."""
+    result=[];editions=set()
+    for observation in reversed(observations):
+        meta=observation['item'].get('extra_data') or {}
+        edition=meta.get('source_timestamp')
+        if meta.get('data_kind')=='youtube_weekly_music_video_chart':edition=meta.get('chart_end_date')
+        if edition and edition in editions:continue
+        if result and (result[-1]['time']-observation['time']).total_seconds()<900:continue
+        result.append(observation)
+        if edition:editions.add(edition)
+    return list(reversed(result))
+
+
+def analyze_history(history,region='global',now=None,limit=20):
+    now=timestamp(now or utcnow());groups=defaultdict(list)
+    for row in history:
+        if row['snapshot'].get('region','global')==region:
+            groups[row['snapshot']['platform']].append(row)
+    output={'region':region,'generated_at':iso_utc(now),'method':'observed_momentum_v1',
+            'policy':{'minimum_observations':3,'minimum_span_hours':1,'minimum_spacing_minutes':15,
+                      'confidence_is_probability':False,'scope':'observed feeds only; no prediction or platform-wide coverage guarantee'},
+            'platforms':{}}
+    for platform,rows in groups.items():
+        rows.sort(key=lambda row:(timestamp(row['snapshot']['started_at']),row['snapshot']['id']))
+        latest=rows[-1];snapshot=latest['snapshot'];age=max(0,(now-timestamp(snapshot.get('fetched_at') or snapshot.get('finished_at') or snapshot['started_at'])).total_seconds())
+        state={'status':'ok','snapshot_id':snapshot['id'],'snapshot_count':len(rows),'latest_age_hours':round(age/3600,3),'max_age_hours':max_age_seconds(platform)/3600,'topics':[]}
+        output['platforms'][platform]=state
+        if snapshot['status']!='success':
+            state.update(status='unavailable',error=snapshot.get('error_message','Latest collection failed'));continue
+        if age>max_age_seconds(platform):state['status']='stale'
+        observed=defaultdict(list)
+        successful=[row for row in rows if row['snapshot']['status']=='success']
+        for row in successful:
+            seen=set()
+            for item in row['topics']:
+                key=identity(platform,item)
+                if key in seen:continue
+                seen.add(key)
+                observed[key].append({'item':item,'time':timestamp(row['snapshot'].get('fetched_at') or row['snapshot']['started_at']),'snapshot_id':row['snapshot']['id']})
+        for current in latest['topics']:
+            key=identity(platform,current);raw=observed[key]
+            same=[row for row in raw if source_context(row['item'])==source_context(current)]
+            points=independent(same);warnings=[];quality_events=[]
+            for before,after in zip(same,same[1:]):
+                context=metric_context(after['item'])
+                a,b=measurement(before['item']),measurement(after['item'])
+                if (context==metric_context(before['item']) and context[0] not in {None,'heat score','weekly views'}
+                    and not context[1][2] and a is not None and b is not None and b<a):
+                    quality_events.append({'type':'metric_decreased_or_reset','from_value':a,'to_value':b,
+                        'from_snapshot_id':before['snapshot_id'],'to_snapshot_id':after['snapshot_id'],
+                        'observed_at':iso_utc(after['time'])})
+            if quality_events:warnings.append('metric_decreased_or_reset')
+            if len(same)!=len(raw):warnings.append('source_context_changed')
+            first,last=points[0],points[-1]
+            span=(last['time']-first['time']).total_seconds()/3600
+            kind=(current.get('extra_data') or {}).get('data_kind','unknown')
+            ranked=kind not in {'public_reels_recommendation_sample','sampled_trending_reels','third_party_hashtag_suggestions','public_hashtag_listing'}
+            if not ranked:warnings.append('recommendation_order_not_ranking')
+            if kind=='youtube_weekly_music_video_chart':warnings.append('weekly_music_chart_only')
+            if kind=='third_party_trend_ranking':warnings.append('third_party_source')
+            if (current.get('extra_data') or {}).get('period_days'):warnings.append('rolling_window_metric_not_cumulative')
+            if kind in {'official_public_trends_preview','public_reels_recommendation_sample','sampled_trending_reels'}:warnings.append('limited_sample_coverage')
+            contexts=[metric_context(point['item']) for point in points]
+            comparable=len(set(contexts))==1 and contexts[-1][0] is not None
+            if len(set(contexts))>1:warnings.append('metric_context_changed')
+            values=[measurement(point['item']) for point in points]
+            comparable=comparable and all(value is not None for value in values)
+            delta=percent=per_hour=None
+            if comparable and len(points)>=2:
+                delta=values[-1]-values[0]
+                percent=round(delta/values[0]*100,2) if values[0]>0 else None
+                per_hour=round(delta/span,3) if span else None
+            if quality_events:delta=percent=per_hour=None
+            ranks=[point['item'].get('rank') for point in points]
+            valid_ranks=ranked and all(isinstance(rank,int) and rank>0 for rank in ranks)
+            rank_change=ranks[0]-ranks[-1] if valid_ranks and len(ranks)>=2 else None
+            sustained_rank=valid_ranks and len(ranks)>=3 and all(b<a for a,b in zip(ranks,ranks[1:])) and rank_change>=2
+            sustained_metric=comparable and len(values)>=3 and all(b>a for a,b in zip(values,values[1:])) and percent is not None and percent>=25
+            enough=len(points)>=3 and span>=1
+            signal='stable';confidence='low'
+            explanation='No sustained positive movement was established in the observed sample.'
+            if len(raw)==1 and len(successful)>1:
+                signal='new_to_sample';explanation='First appearance in this sampled lookback window; origin and wider popularity are unknown.'
+            elif not enough:
+                signal='insufficient_history';explanation='Need at least three independent observations spanning one hour before flagging momentum.'
+            elif 'metric_decreased_or_reset' in warnings:
+                signal='insufficient_evidence';explanation='A measurement decreased or reset; it is unsafe to calculate a growth signal from these points.'
+            elif sustained_rank or sustained_metric:
+                signal='rising_candidate';confidence='moderate'
+                reasons=[]
+                if sustained_rank:reasons.append(f'rank improved by {rank_change} positions across {len(points)} observations')
+                if sustained_metric:reasons.append(f'observed {contexts[-1][0]} increased {percent}% over {span:.2f} hours')
+                explanation='; '.join(reasons)+'. This is a sampled momentum candidate, not a prediction.'
+            elif (rank_change is not None and rank_change<=-2) or (percent is not None and percent<=-25):
+                signal='falling';confidence='moderate';explanation='Observed rank or a comparable metric declined across the window.'
+            elif (rank_change is not None and rank_change>=2) or (percent is not None and percent>=25):
+                signal='mixed_movement';explanation='Net improvement was observed, but intermediate observations did not show sustained growth.'
+            if state['status']=='stale':
+                warnings.append('stale_latest_observation');signal='insufficient_evidence';confidence='low'
+            state['topics'].append({'topic_key':key,'title':current['title'],'url':current.get('url',''),'signal':signal,'confidence':confidence,
+                'observations':len(points),'raw_observations':len(raw),'span_hours':round(span,3),
+                'first_seen_in_window':len(raw)==1,'rank_change':rank_change,'metric':{'unit':contexts[-1][0],
+                'change':delta,'change_percent':percent,'per_hour':per_hour,'window':contexts[-1][1],
+                'rate_definition':'Net change in reported metric per elapsed hour, not new events per hour'},'warnings':warnings,'quality_events':quality_events,'explanation':explanation,
+                'evidence':[{'snapshot_id':point['snapshot_id'],'observed_at':iso_utc(point['time']),
+                             'rank':point['item'].get('rank') if ranked else None,'metric_value':measurement(point['item']),
+                             'metric_unit':metric_context(point['item'])[0],'metric_window':metric_context(point['item'])[1]} for point in points]})
+        priority={'rising_candidate':0,'new_to_sample':1,'falling':2,'mixed_movement':3,'stable':3,'insufficient_history':4,'insufficient_evidence':5}
+        state['topics'].sort(key=lambda item:priority[item['signal']])
+        state['topics_analyzed']=len(state['topics'])
+        state['rising_candidates']=sum(topic['signal']=='rising_candidate' for topic in state['topics'])
+        state['topics']=state['topics'][:limit]
+    output['summary']={'rising_candidates':sum(state.get('rising_candidates',0) for state in output['platforms'].values()),
+                       'note':'Signals describe stored observations. Limited history, changing sources, sampling and missing metrics restrict conclusions.'}
+    return output
+
+
+async def analyze_database(session,platform=None,region='global',hours=48,limit=20):
+    targets=[platform] if platform else list(Platform)
+    snapshots=[];truncated={}
+    cutoff=utcnow()-timedelta(hours=hours)
+    for target in targets:
+        query=select(ScrapeSnapshot).where(ScrapeSnapshot.region==region,
+            ScrapeSnapshot.platform==target,ScrapeSnapshot.started_at>=cutoff)
+        rows=(await session.execute(query.order_by(desc(ScrapeSnapshot.started_at),desc(ScrapeSnapshot.id)).limit(501))).scalars().all()
+        truncated[target.value]=len(rows)>500
+        snapshots.extend(rows[:500])
+    by_id=await load_topics(session,snapshots)
+    result=analyze_history([{'snapshot':row.to_dict(),'topics':by_id[row.id]} for row in snapshots],region=region,limit=limit)
+    for target in targets:
+        try:
+            validate_region(target,region)
+        except ValueError as error:
+            result['platforms'][target.value]={'status':'unsupported','error':str(error),'topics':[]}
+            continue
+        result['platforms'].setdefault(target.value,{'status':'insufficient_history','snapshot_count':0,'topics':[]})
+        result['platforms'][target.value]['history_truncated']=truncated[target.value]
+    result['lookback_hours']=hours;result['history_truncated']=any(truncated.values())
+    return result

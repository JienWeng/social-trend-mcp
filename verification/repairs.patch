+@router.get('/search/exact')
+async def exact_search(q:str=Query(...,min_length=1,max_length=200),region:str=Query('global'),platforms:Optional[str]=Query(None)):
+    q=checked_query(q);region=checked_region(region)
+    items,coverage=await collect_trends(selected_platforms(platforms),region,fetch)
+    needle=q.casefold()
+    matches=[(p,item) for p,item in items if needle in item.title.casefold() or needle in item.hashtag.casefold()]
+    scored=find_related_from_trends(q,matches,min_score=1)
+    return {"success":any(x['status']=='ok' for x in coverage.values()),"query":q,"type":"exact",
+            "scope":"observed trend feeds; not full platform search","region":region,"coverage":coverage,
+            "total":len(scored),"results":[scored_dict(x) for x in scored[:30]]}
